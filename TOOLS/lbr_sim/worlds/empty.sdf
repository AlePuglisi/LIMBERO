        <constant>0.8</constant>
        <linear>0.01</linear>
        <quadratic>0.0005</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <include>
      <uri> mars_surface_2 </uri>
    </include>

    <include>
      <uri> perseverance </uri>
      <pose> 1.5 -4.0 0.1 1.57 -0.1 2.25 </pose>
    </include>

