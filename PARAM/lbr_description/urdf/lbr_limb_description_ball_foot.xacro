      <child
        link="${prefix}_coxa" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-3.14"
        upper="3.14"
        effort="5"
        velocity="5" />
    </joint>
    <link
      name="${prefix}_femur">
      <inertial>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <mass
