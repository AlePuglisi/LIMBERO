      type="revolute">
      <origin
        xyz="0.20029 0 0"
        rpy="0 0 0" />
      <parent
        link="${prefix}_tibia" />
      <child
        link="${prefix}_end_effector" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="-3.14"
        upper="3.14"
        effort="5"
        velocity="5" />
    </joint>
    <link
      name="${prefix}_foot">
      <inertial>
        <origin
          xyz="-0.0187948041155833 -6.93889390390723E-18 -1.66414272382424E-16"
          rpy="0 0 0" />
        <mass
          value="0.0290783866321465" />
        <inertia
          ixx="5.1844927665664E-06"
          ixy="-7.94093388050907E-23"
          ixz="5.88529380841861E-21"
          iyy="4.56229619884267E-06"
          iyz="3.43690454744652E-22"
          izz="4.56229619884267E-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="file://$(find lbr_description)/meshes/palm.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.2 0.2 0.2 1" />
        </material>
      </visual>
      <collision name="${prefix}_foot_collision">
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="file://$(find lbr_description)/meshes/palm.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}_foot"
      type="fixed">
      <origin
        xyz="0.0832 0 0"
        rpy="0 0 0" />
      <parent
        link="${prefix}_end_effector" />
      <child
        link="${prefix}_foot" />
      <axis
        xyz="0 0 0" />
    </joint>

    <!-- Gazebo plugin for contact sensor  -->
    <gazebo reference="${prefix}_foot">
      <sensor name="${prefix}_foot_bumper_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <contact>
        <collision>${prefix}_end_effector_fixed_joint_lump__${prefix}_foot_collision_collision_1</collision>
        </contact>
        <plugin name="${prefix}_foot_bumper" filename="libgazebo_ros_bumper.so">
          <ros>
            <namespace>${prefix}</namespace>
          </ros>
          <frame_name>${prefix}_foot</frame_name>
        </plugin>
      </sensor>
    </gazebo>
    <!-- Gazebo plugin for joint state publisher  -->
    <gazebo>
      <plugin name="${prefix}_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
        <ros>
          <namespace>${prefix}</namespace>
          <remapping>~/out:=joint_states</remapping>
        </ros>
        <update_rate>30</update_rate>
        <joint_name>${prefix}_B2C</joint_name>
        <joint_name>${prefix}_C2F</joint_name>
        <joint_name>${prefix}_F2T</joint_name>
        <joint_name>${prefix}_T2E</joint_name>
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>
