<robot
  name="LIMBERO_v1_4_Limb" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="limb_macro" params="prefix parent radius">

    <joint
      name="${prefix}_joint"
      type="fixed">
      <origin
        rpy="0 0 ${radians(radius)}"
        xyz="${0.2*cos(radians(radius))} ${0.2*sin(radians(radius))} 0"/>
      <parent
        link="${parent}" />
      <child
        link="${prefix}_limb_root" />
    </joint>

    <link
      name="${prefix}_limb_root">
      <inertial>
        <origin
          xyz="-0.0149642229992232 -0.0473183300715678 0.00138939560478386"
          rpy="0 0 0" />
        <mass
          value="0.0845895186390118" />
        <inertia
          ixx="2.1691798951859E-05"
          ixy="-1.611902649885E-07"
          ixz="1.54571395510868E-06"
          iyy="3.17282415672239E-05"
          iyz="1.49662485076318E-08"
          izz="3.81961034645894E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="file://$(find lbr_description)/meshes/limb_root.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.2 0.2 0.2 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="file://$(find lbr_description)/meshes/limb_root.STL" />
        </geometry>
      </collision>
    </link>
    <link
      name="${prefix}_coxa">
      <inertial>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <mass
          value="0.0910904516001775" />
        <inertia
          ixx="2.35199715515964E-05"
          ixy="-1.61883588944024E-07"
          ixz="4.58361342342776E-14"
          iyy="3.36342088725393E-05"
          iyz="9.80227931256417E-14"
          izz="4.21224113002182E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="file://$(find lbr_description)/meshes/coxa.STL" />
        </geometry>
        <material
