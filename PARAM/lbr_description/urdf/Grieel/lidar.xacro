    <gazebo reference="lidar_link">
        <sensor type="ray" name="velodyne2-HDL32E">
          <pose>0 0 0 0 0 0</pose>
          <visualize>false</visualize>
          <update_rate>10</update_rate>

          <ray>
                <scan>
                    <horizontal>
                        <samples>150</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.142</min_angle>
                        <max_angle>3.142</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>30</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.25</min_angle>
                        <max_angle> 0.1</max_angle>
                    </vertical>
                </scan>

                <range>
                    <min>0.3</min>
                    <max>300.0</max>
                    <resolution>0.001</resolution>
                </range>

                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.0</stddev>
                </noise>
          </ray>

          <plugin name="gazebo_ros_laser_controller" filename="libgazebo_ros_velodyne_laser.so">
            <ros>
              <namespace>/velodyne2</namespace>
              <remapping>~/out:=velodyne_points2</remapping>
            </ros>

            <frame_name>lidar_link</frame_name>
            <organize_cloud>false</organize_cloud>
            <min_range>0.9</min_range>
            <max_range>300.0</max_range>
            <gaussian_noise>0.008</gaussian_noise>
          </plugin>
        </sensor>
    </gazebo>

</robot>