<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:arg name="wheel_mode" default="true" />

    <xacro:if value="$(arg wheel_mode)">
        <xacro:include filename="$(find lbr_description)/urdf/Grieel/grieel_wheel_description.xacro" />
    </xacro:if>

    <xacro:unless value="$(arg wheel_mode)">
        <xacro:include filename="$(find lbr_description)/urdf/Grieel/grieel_gripper_description.xacro" />
    </xacro:unless>

    <xacro:include filename="$(find lbr_description)/urdf/Grieel/lbr_limb_description.xacro" />

            <!-- Gazebo plugin for joint state publisher  -->
    <gazebo>
        <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system">

            <!-- <update_rate>500</update_rate> -->
            <topic>/joint_states</topic>
            <!-- <joint_name>world_base</joint_name> -->

            <joint_name>LF_B2C</joint_name>
            <joint_name>LF_C2F</joint_name>
            <joint_name>LF_F2T</joint_name>
            <joint_name>LF_T2E</joint_name>
            <joint_name>LF_wristH</joint_name>
            <joint_name>LF_wristV</joint_name>
            <joint_name>LF_driving</joint_name>

            <joint_name>LH_B2C</joint_name>
            <joint_name>LH_C2F</joint_name>
            <joint_name>LH_F2T</joint_name>
            <joint_name>LH_T2E</joint_name>
            <joint_name>LH_wristH</joint_name>
            <joint_name>LH_wristV</joint_name>
            <joint_name>LH_driving</joint_name>

            <joint_name>RH_B2C</joint_name>
            <joint_name>RH_C2F</joint_name>
            <joint_name>RH_F2T</joint_name>
            <joint_name>RH_T2E</joint_name>
            <joint_name>RH_wristH</joint_name>
            <joint_name>RH_wristV</joint_name>
            <joint_name>RH_driving</joint_name>

            <joint_name>RF_B2C</joint_name>
            <joint_name>RF_C2F</joint_name>
            <joint_name>RF_F2T</joint_name>
            <joint_name>RF_T2E</joint_name>
            <joint_name>RF_wristH</joint_name>
            <joint_name>RF_wristV</joint_name>
            <joint_name>RF_driving</joint_name>
        </plugin>
    </gazebo>
</robot>