<robot
  name="LIMBERO_v1_7_Limb" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="limb_macro" params="prefix parent radius">

    <joint
      name="${prefix}_joint"
      type="fixed">
      <origin
        rpy="0 0 ${radians(radius)}"
        xyz="${0.2*cos(radians(radius))} ${0.2*sin(radians(radius))} 0"/>
      <parent
        link="${parent}" />
      <child
        link="${prefix}_limb_root" /> <xacro:include filename="$(find lbr_description)/urdf/Grieel/grieel_gripper_description.xacro" />
    </joint>

    <link
      name="${prefix}_limb_root">
      <inertial>
        <origin
          xyz="-0.015029 -7.7571E-11 -0.047318"
          rpy="0 0 0" />
        <mass
          value="0.08459" />
        <inertia
          ixx="2.1548E-05"
          ixy="-4.775E-14"
          ixz="-1.6188E-07"
          iyy="3.834E-05"
          iyz="-8.2973E-14"
          izz="3.1728E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="file://$(find lbr_description)/meshes/limb_root.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.2 0.2 0.2 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="file://$(find lbr_description)/meshes/limb_root.STL" />
        </geometry>
      </collision>
    </link>

    <link
      name="${prefix}_coxa">
      <inertial>
        <origin
          xyz="0.015938 0.00063302 -0.0015013"
          rpy="0 0 0" />
        <mass
          value="0.09109" />
        <inertia
          ixx="2.352E-05"
          ixy="-1.6188E-07"
          ixz="4.775E-14"
          iyy="3.3634E-05"
          iyz="8.2973E-14"
          izz="4.2122E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="file://$(find lbr_description)/meshes/coxa.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.2 0.2 0.2 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="file://$(find lbr_description)/meshes/coxa.STL" />
        </geometry>
      </collision>
    </link>

    <joint
      name="${prefix}_B2C"
      type="revolute">
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <parent
        link="${prefix}_limb_root" />
      <child
        link="${prefix}_coxa" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-3.14"
        upper="3.14"
        effort="50"
        velocity="10" />
      <dynamics damping="0.1" friction="0.4"/>
    </joint>

    <!-- <transmission name="${prefix}_B2C_transmission">
      <type>transmission_interface/SimpleTransmission</type>
        <joint name="${prefix}_B2C">
