        </geometry>
      </collision>
    </link>

    <joint
      name="${prefix}_T2E"
      type="revolute">
      <origin
        xyz="0.2 0 0"
        rpy="0 0 0" />
      <parent
        link="${prefix}_tibia" />
      <child
        link="${prefix}_limb_end" />
      <axis
