        upper="3.14"
        effort="50"
        velocity="10" />
      <dynamics damping="0.1" friction="0.4"/>
    </joint>

    <!-- <transmission name="${prefix}_T2E_transmission">
      <type>transmission_interface/SimpleTransmission</type>
        <joint name="${prefix}_T2E">
