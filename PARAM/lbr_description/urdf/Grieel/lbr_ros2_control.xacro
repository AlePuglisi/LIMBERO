<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="ros2_control_macro" params="prefix wheel_mode">

    <ros2_control name="${prefix}_ros2_control" type="system">

      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>

      <joint name="${prefix}_B2C">
        <command_interface name="position">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-2.8</param>
          <param name="max">2.8</param>
        </command_interface>
        <command_interface name="effort">
          <!-- <param name="min">-8</param>
          <param name="max">8</param> -->
          <param name="min">-50</param>
          <param name="max">50</param>
        </command_interface>
        <state_interface name="position">  <!-- Set initial joint position -->
          <param name="initial_value"> 0.0 </param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <transmission name="${prefix}_B2C_transmission">
          <plugin>transmission_interface/SimpleTransmission</plugin>
          <param name="joint_to_actuator">272.5</param>
          <hardwareInterface>EffortJointInterface</hardwareInterface>
        </transmission>
      </joint>

      <joint name="${prefix}_C2F">
        <command_interface name="position">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-2.8</param>
          <param name="max">2.8</param>
        </command_interface>
        <command_interface name="effort">
          <!-- <param name="min">-8</param>
          <param name="max">8</param> -->
          <param name="min">-50</param>
          <param name="max">50</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value"> 0.0 </param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <transmission name="${prefix}_C2F_transmission">
          <plugin>transmission_interface/SimpleTransmission</plugin>
          <param name="joint_to_actuator">272.5</param>
          <hardwareInterface>EffortJointInterface</hardwareInterface>
        </transmission>
      </joint>

      <joint name="${prefix}_F2T">
        <command_interface name="position">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-4</param>
          <param name="max">4</param>
        </command_interface>
        <command_interface name="effort">
          <!-- <param name="min">-3.4</param>
          <param name="max">3.4</param> -->
          <param name="min">-50</param>
          <param name="max">50</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value"> ${pi/2} </param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <transmission name="${prefix}_F2T_transmission">
          <plugin>transmission_interface/SimpleTransmission</plugin>
          <param name="joint_to_actuator">353.5</param>
          <hardwareInterface>EffortJointInterface</hardwareInterface>
        </transmission>
      </joint>

      <joint name="${prefix}_T2E">
        <command_interface name="position">
          <param name="min">-100</param>
          <param name="max">100</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-4</param>
          <param name="max">4</param>
        </command_interface>
        <command_interface name="effort">
          <!-- <param name="min">-3.4</param>
          <param name="max">3.4</param> -->
          <param name="min">-50</param>
          <param name="max">50</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value"> 0.0 </param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <transmission name="${prefix}_T2E_transmission">
          <plugin>transmission_interface/SimpleTransmission</plugin>
          <param name="joint_to_actuator">353.5</param>
          <hardwareInterface>EffortJointInterface</hardwareInterface>
        </transmission>
      </joint>


      <joint name="${prefix}_wristH">
        <command_interface name="position">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-5</param>
          <param name="max">5</param>
        </command_interface>
        <command_interface name="effort">
          <!-- <param name="min">-1.20</param>
          <param name="max">1.20</param> -->
          <param name="min">-50</param>
          <param name="max">50</param>
        </command_interface>
        <state_interface name="position">
          <xacro:if value="$(arg wheel_mode)">
            <param name="initial_value"> ${pi} </param>
          </xacro:if>
          <xacro:unless value="$(arg wheel_mode)">
            <param name="initial_value"> 0.0 </param>
          </xacro:unless>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <transmission name="${prefix}_wristH_transmission">
          <plugin>transmission_interface/SimpleTransmission</plugin>
          <param name="joint_to_actuator">257.4</param>
          <hardwareInterface>EffortJointInterface</hardwareInterface>
        </transmission>
      </joint>

      <joint name="${prefix}_wristV">
        <command_interface name="position">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-5</param>
          <param name="max">5</param>
        </command_interface>
        <command_interface name="effort">
          <!-- <param name="min">-1.20</param>
          <param name="max">1.20</param> -->
          <param name="min">-50</param>
          <param name="max">50</param>
        </command_interface>
        <state_interface name="position">
          <xacro:if value="$(arg wheel_mode)">
            <param name="initial_value"> ${pi/2} </param>
          </xacro:if>
          <xacro:unless value="$(arg wheel_mode)">
            <param name="initial_value"> 0.0 </param>
          </xacro:unless>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <transmission name="${prefix}_wristV_transmission">
          <plugin>transmission_interface/SimpleTransmission</plugin>
          <param name="joint_to_actuator">257.4</param>
          <hardwareInterface>EffortJointInterface</hardwareInterface>
        </transmission>
      </joint>

      <joint name="${prefix}_driving">
        <command_interface name="position">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-4</param>
          <param name="max">4</param>
        </command_interface>
        <command_interface name="effort">
          <!-- <param name="min">-3.4</param>
          <param name="max">3.4</param> -->
          <param name="min">-50</param>
          <param name="max">50</param>
        </command_interface>
        <state_interface name="position">
          <xacro:if value="$(arg wheel_mode)">
            <param name="initial_value"> 0.0 </param>
          </xacro:if>
          <xacro:unless value="$(arg wheel_mode)">
            <param name="initial_value"> 0.0 </param>
          </xacro:unless>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <transmission name="${prefix}_driving_transmission">
          <plugin>transmission_interface/SimpleTransmission</plugin>
          <param name="joint_to_actuator">353.4</param>
          <hardwareInterface>EffortJointInterface</hardwareInterface>
        </transmission>
      </joint>


    </ros2_control>

  </xacro:macro>

</robot>
