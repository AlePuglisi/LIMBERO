    <joint
      name="${prefix}_palm"
      type="fixed">
      <origin
        xyz="0.1035 0 0"
        rpy="0 0 0" />
      <parent
        link="${prefix}_end_effector" />
      <child
        link="${prefix}_palm" />
      <axis
        xyz="0 0 0" />
    </joint>
      <!-- Gazebo plugin for contact sensor  -->
    <gazebo reference="${prefix}_palm">
      <sensor name="${prefix}_gripper_bumper_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <contact>
        <collision>${prefix}_limb_end_fixed_joint_lump__${prefix}_palm_collision_2</collision>
        </contact>
        <plugin name="${prefix}_gripper_bumper" filename="libgazebo_ros_bumper.so">
          <ros>
            <namespace>${prefix}</namespace>
          </ros>
          <frame_name>${prefix}_gripper</frame_name>
        </plugin>
      </sensor>
    </gazebo>
    <!-- Gazebo plugin for joint state publisher  -->
    <gazebo>
      <plugin name="${prefix}_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
        <ros>
          <namespace>${prefix}</namespace>
          <remapping>~/out:=joint_states</remapping>
        </ros>
        <update_rate>30</update_rate>
        <joint_name>${prefix}_B2C</joint_name>
        <joint_name>${prefix}_C2F</joint_name>
        <joint_name>${prefix}_F2T</joint_name>
        <joint_name>${prefix}_T2E</joint_name>
      </plugin>
    </gazebo>
  </xacro:macro>
