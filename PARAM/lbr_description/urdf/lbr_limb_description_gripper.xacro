<robot
  name="LIMBERO_v1_8_Limb" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="limb_macro" params="prefix parent radius">
    <joint
      name="${prefix}_joint"
      type="fixed">
      <origin
        rpy="0 0 ${radians(radius)}"
        xyz="${0.2*cos(radians(radius))} ${0.2*sin(radians(radius))} 0"/>
      <parent
        link="${parent}" />
      <child
        link="${prefix}_limb_root" />
    </joint>

    <link
      name="${prefix}_limb_root">
      <inertial>
        <origin
          xyz="-0.015029 -0.047318 7.7573E-11"
