    <joint
      name="${prefix}_end_effector"
      type="fixed">
      <origin
        xyz="0.01125 0 0.00025"
        rpy="0 0 0" />
      <parent
        link="${prefix}_limb_end" />
      <child
        link="${prefix}_end_effector" />
      <axis
        xyz="0 0 0" />
    </joint>
    <link
      name="${prefix}_palm">
      <inertial>
        <origin
          xyz="-0.032677 0.00014136 -0.0017833"
          rpy="0 0 0" />
        <mass
