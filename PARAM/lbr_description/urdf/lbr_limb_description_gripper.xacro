          rpy="0 0 0" />
        <mass
          value="0.2396" />
        <inertia
          ixx="6.9752E-05"
          ixy="2.5824E-07"
          ixz="5.838E-07"
          iyy="5.2421E-05"
          iyz="-1.1385E-07"
