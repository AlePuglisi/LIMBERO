<robot name="LIMBERO" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find lbr_description)/urdf/lbr_base_description.xacro" />

  <!-- To switch end-effector (gripper or ball foot) -->
  <!-- <xacro:include filename="$(find lbr_description)/urdf/lbr_limb_description_ball_foot.xacro" /> -->
  <xacro:include filename="$(find lbr_description)/urdf/lbr_limb_description_gripper.xacro" />

  <xacro:include filename="$(find lbr_description)/urdf/lbr_gazebo.xacro" />

  <xacro:include filename="$(find lbr_description)/urdf/lbr_ros2_control.xacro" />

  <!-- Use macro to define base and four limbs -->
  <xacro:base_macro/>

  <xacro:limb_macro prefix="LF" parent="base_link" radius="45"/>
  <xacro:limb_macro prefix="LH" parent="base_link" radius="135"/>
  <xacro:limb_macro prefix="RH" parent="base_link" radius="225"/>
  <xacro:limb_macro prefix="RF" parent="base_link" radius="315"/>

  <xacro:ros2_control_macro prefix="LF"/>
  <xacro:ros2_control_macro prefix="LH"/>
  <xacro:ros2_control_macro prefix="RH"/>
  <xacro:ros2_control_macro prefix="RF"/>

</robot>
